datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model OrganizationSetting {
  id                 String   @id @default("default-org")
  companyName        String   @default("TechNova Solutions")
  website            String   @default("https://technova.com")
  description        String   @default("Cloud and Enterprise IT Solutions Provider")
  productsCatalog    String   @default("Microsoft 365, SharePoint Implementation, Workflow Automation")
  targetKeywords     String   @default("SharePoint, Microsoft 365, Cloud Migration, Workflow Automation")
  voiceMinutesUsed   Int      @default(12450)
  voiceMinutesLimit  Int      @default(20000)
  aiPersonaName      String   @default("Ava (Sales Executive)")
  aiLanguageDefault  String   @default("en")
  isApprovedForAi    Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Lead {
  id                  String     @id @default(cuid())
  name                String
  email               String?
  emailVerified       Boolean    @default(false)
  phone               String?
  phoneVerified       Boolean    @default(false)
  linkedinProfile     String?
  companyName         String
  companyWebsite      String?
  jobTitle            String
  industry            String     @default("IT Services")
  companySize         String     @default("51 - 200 employees")
  sourcePlatform      String     @default("LinkedIn") // LinkedIn, X (Twitter), Company Websites, Directories, Freelance Platforms, CRM Integrations
  originalPostUrl     String?
  originalPostSnippet String?
  discoveryDate       DateTime   @default(now())
  
  // Qualification & Predictive Intent Scoring
  intentScore         Int        @default(85)
  budgetSignal        String     @default("High")
  urgencyLevel        String     @default("High")
  decisionMaker       Boolean    @default(true)
  activeRequirement   Boolean    @default(true)
  
  // Lifecycle status
  status              String     @default("DISCOVERED") // DISCOVERED, ENRICHED, READY_TO_ENGAGE, CALL_SCHEDULED, CONTACTED, INTERESTED, MEETING_BOOKED, CALLBACK_SCHEDULED, DND
  
  // Location & Regional Multilingual Intelligence
  location            String?    @default("Global")
  country             String?    @default("United States")
  timezone            String?    @default("America/New_York")
  preferredLanguage   String?    @default("English")
  
  // Workflow Selection: Calling Only vs Leads + Calling
  workflowType        String?    @default("LEADS_AND_CALLING") // CALLING_ONLY, LEADS_AND_CALLING
  
  // Retry / Callback automation & Compliance
  retryCount          Int?       @default(0)
  scheduledCallbackAt DateTime?
  dndStatus           Boolean?   @default(false)

  // Calendly Tracking & Human Handoff SMS
  calendlyLinkSent    Boolean?   @default(false)
  calendlyLinkSentAt  DateTime?
  calendlyStatus      String?    @default("NONE") // NONE, LINK_SENT, BOOKED, NOT_BOOKED, REDIAL_TRIGGERED
  calendlyEventUri    String?
  calendlyBookedAt    DateTime?
  redialScheduledAt   DateTime?
  redialCount         Int?       @default(0)
  
  campaignId          String?
  campaign            Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  calls               CallLog[]

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Campaign {
  id                 String    @id @default(cuid())
  name               String
  status             String    @default("RUNNING") // DRAFT, RUNNING, PAUSED, COMPLETED
  targetIndustry     String    @default("All")
  targetLocation     String    @default("Global")
  progressPercent    Int       @default(0)
  totalLeadsCount    Int       @default(0)
  callsMadeCount     Int       @default(0)
  conversationsCount Int       @default(0)
  interestedCount    Int       @default(0)
  meetingsBooked     Int       @default(0)
  
  // Custom lead criteria & workflow
  workflowType       String?   @default("LEADS_AND_CALLING") // CALLING_ONLY, LEADS_AND_CALLING
  targetLanguage     String?   @default("Auto (Lead Location)")
  minIntentScore     Int?      @default(75)
  decisionMakerOnly  Boolean?  @default(false)
  scheduleType       String?   @default("Daily (9 AM - 5 PM Local)")
  timezone           String?   @default("Auto (Prospect Local)")
  repeatCadence      String?   @default("Daily")
  dailyLimit         Int?      @default(150)
  
  leads              Lead[]
  calls              CallLog[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model CallLog {
  id                 String    @id @default(cuid())
  leadId             String
  lead               Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId         String?
  campaign           Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  
  status             String    @default("CONNECTED") // DIALING, RINGING, CONNECTED, VOICEMAIL, RETRY_SCHEDULED, FAILED, HUMAN_HANDOFF, DND_REQUESTED
  outcome            String    @default("INTERESTED") // INTERESTED, MEETING_BOOKED, VOICEMAIL_LEFT, RETRY_SCHEDULED, NOT_INTERESTED, DND, HUMAN_HANDOFF
  durationSeconds    Int       @default(145)
  language           String    @default("en")
  telephonyProvider  String?   @default("STUDIO_WEB") // STUDIO_WEB, TWILIO_VOICE
  
  // Call artifacts & Sentiment
  callSummary        String?
  nextBestAction     String?
  transcriptJson     String?   // JSON array of { speaker: "agent"|"prospect", text: string, timestamp: string, sentiment?: string }
  sentiment          String?   @default("POSITIVE") // POSITIVE, NEUTRAL, HESITANT, OBJECTION, NEGATIVE
  meetingScheduledAt DateTime?
  callbackScheduledAt DateTime?
  recordingUrl       String?
  handoffNotes       String?
  twilioCallSid      String?
  calendlyLinkSent   Boolean?  @default(false)
  calendlyUrl        String?

  createdAt          DateTime  @default(now())
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  companyName String?
  companySize String?
  industry    String?
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

